# Local development: copy to .env.local (`cp .env.example .env.local`).
# Postgres runs in Docker (`pnpm db:up`); photos are stored in .data/blob/.
OWINZ_IO_DATABASE_URL=postgres://owinz:owinz@localhost:54322/owinz
OWINZ_IO_DATABASE_URL_UNPOOLED=postgres://owinz:owinz@localhost:54322/owinz
OWINZ_IO_BLOB_DRIVER=local

# CMS sign-in (Better Auth). Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Invited as editor when a fresh database is seeded (pnpm db:seed / pnpm build)
OWINZ_IO_FIRST_EDITOR=
# Sign in with a link printed to the `pnpm dev` terminal (local Postgres only)
OWINZ_IO_DEV_LOGIN=1
# GitHub OAuth app whose callback is http://localhost:3000/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# To use real services instead, set the Neon URLs above to a Neon branch and:
# OWINZ_IO_BLOB_DRIVER=vercel
# OWINZ_IO_READ_WRITE_TOKEN=vercel_blob_rw_…
# OWINZ_IO_BLOB_ACCESS=private   # the stores are private; set public only for a public store
