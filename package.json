{
  "name": "owinz.io.v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:migrate && pnpm db:seed && next build && node scripts/seo-audit.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-if-empty.ts",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "content:check": "node scripts/validate-content.mjs",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/import-content.ts",
    "content:export": "tsx --env-file-if-exists=.env.local scripts/export-content.ts",
    "cms:invite": "tsx --env-file-if-exists=.env.local scripts/cms-invite.ts",
    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.564.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "reading-time-estimator": "^2.6.0",
    "recharts": "2.15.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
